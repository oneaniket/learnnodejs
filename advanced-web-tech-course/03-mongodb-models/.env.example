# Copy this file to `.env` and fill in your real values.
# `.env` is gitignored, so your password is never pushed to GitHub.

# Local MongoDB:
MONGODB_URI=mongodb://127.0.0.1:27017/coursedb

# OR MongoDB Atlas (replace USER, PASSWORD, and the cluster host):
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/coursedb
